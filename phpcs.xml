<?xml version="1.0"?>
<ruleset name="HeadlessWP">
    <description>PHPCS ruleset for the Headless WP plugin (WPCS + PHP 8.2).</description>

    <file>src</file>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- WordPress Coding Standards -->
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra">
        <!-- PSR-4 namespaces use PascalCase filenames, not WP convention -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>

    <!-- PHP compatibility for WP minimum -->
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.2-"/>
    <config name="minimum_supported_wp_version" value="6.0"/>

    <!-- Namespace prefix requirement -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="hwp"/>
                <element value="HWP"/>
                <element value="headless_wp"/>
                <element value="HEADLESS_WP"/>
            </property>
        </properties>
    </rule>

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>tests/*</exclude-pattern>
    <exclude-pattern>assets/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
</ruleset>
