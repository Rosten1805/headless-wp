{
    "name": "rosten1805/headless-wp",
    "description": "WordPress plugin that exposes WP data as a configurable REST API with JWT, API Keys, granular permissions and auto-generated OpenAPI docs.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Rosten1805",
            "homepage": "https://github.com/Rosten1805"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "*",
        "yoast/phpunit-polyfills": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "HWP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HWP\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test":       "phpunit --colors=always",
        "test:unit":  "phpunit --colors=always --testsuite=Unit",
        "test:int":   "phpunit --colors=always --testsuite=Integration",
        "lint":       "phpcs --standard=phpcs.xml src/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable"
}
